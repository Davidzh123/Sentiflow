+from datetime import datetime, timedelta
+
+import pytest
+
+from backend.app.services.twitter import TwitterService, parse_tweet_datetime
+
+
+def tweet(tweet_id: str, created_at: datetime | None = None) -> dict:
+    return {
+        "id": tweet_id,
+        "text": f"tweet {tweet_id}",
+        "createdAt": (created_at or datetime.utcnow()).isoformat() + "Z",
+        "author": {"id": "1", "userName": "tester"},
+    }
+
+
+def test_parse_tweet_datetime_supports_twitter_and_iso_formats():
+    twitter_date = parse_tweet_datetime(
+        {"createdAt": "Mon Jun 15 12:30:45 +0000 2026"}
+    )
+    iso_date = parse_tweet_datetime({"createdAt": "2026-06-15T12:30:45Z"})
+
+    assert twitter_date == datetime(2026, 6, 15, 12, 30, 45)
+    assert iso_date == datetime(2026, 6, 15, 12, 30, 45)
+
+
+@pytest.mark.asyncio
+async def test_search_tweets_splits_full_time_windows(monkeypatch):
+    service = TwitterService()
+    service.api_key = "test-key"
+    calls = []
+
+    async def fake_get(path, params):
+        calls.append((path, params))
+        if len(calls) == 1:
+            return {"tweets": [tweet(f"full-{i}") for i in range(20)]}
+        return {"tweets": [tweet(f"split-{len(calls)}-{i}") for i in range(3)]}
+
+    monkeypatch.setattr(service, "_get", fake_get)
+
+    result = await service.search_tweets("#france", days=3, max_tweets=100)
+
+    assert result["api_requests"] == 3
+    assert len(result["tweets"]) == 6
+    assert "since_time:" in calls[0][1]["query"]
+    assert "until_time:" in calls[0][1]["query"]
+
+
+@pytest.mark.asyncio
+async def test_get_user_tweets_paginates_until_cutoff(monkeypatch):
+    service = TwitterService()
+    service.api_key = "test-key"
+    now = datetime.utcnow()
+
+    async def fake_get(path, params):
+        if params.get("cursor") == "next":
+            return {
+                "tweets": [
+                    tweet("old", now - timedelta(days=5)),
+                    tweet("second-page", now - timedelta(hours=2)),
+                ],
+                "has_next_page": True,
+                "next_cursor": "older",
+            }
+        return {
+            "tweets": [tweet("first-page", now - timedelta(hours=1))],
+            "has_next_page": True,
+            "next_cursor": "next",
+        }
+
+    monkeypatch.setattr(service, "_get", fake_get)
+
+    result = await service.get_user_tweets("@openai", days=2, max_tweets=100)
+    ids = [item["id"] for item in result["tweets"]]
+
+    assert result["api_requests"] == 2
+    assert ids == ["first-page", "second-page"]
